# What core A's given code and alternative are supposed to do.
# Read by tests/run_tests.sh, which is identical in all four cores.

VARIATION=A

# The alternative your BRIEF names, and whether it is supposed to be correct.
ALT_LABEL="one shared mutex, locked and unlocked once per element"
ALT_CORRECT=yes

# The one timing claim that is auto-checked. Everything else about the
# measurement is marked from RESULTS.md.
#   fixed_faster_than_given | fixed_faster_than_alt | none
SPEED_CHECK=fixed_faster_than_alt
